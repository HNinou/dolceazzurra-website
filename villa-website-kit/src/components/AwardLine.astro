---
import { t } from '../lib/i18n';
import { house } from '../lib/villa';
interface Props { locale: string }
const { locale } = Astro.props;
const aw = house.award;
---
<div class="award">
  <p class="line"><span>{t(locale, 'award.longlisted')}</span><span aria-hidden="true">·</span><span>{aw.name}</span><span aria-hidden="true">·</span><span>{t(locale, 'award.category')}</span></p>
  <p class="credit">{t(locale, 'award.designedBy')} <a href={house.architect.url} rel="noopener">{house.architect.name}</a></p>
</div>
<style>
  .award { border-top: 1px solid var(--c-oak); padding-top: var(--space-3); }
  .line { display: flex; flex-wrap: wrap; gap: .2rem .6rem; font: 500 var(--step--1)/1.5 var(--font-text); letter-spacing: .08em; text-transform: uppercase; margin-bottom: .4rem; }
  .credit { color: var(--c-ink-soft); margin: 0; }
</style>
