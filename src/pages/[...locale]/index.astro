---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import FactsStrip from '../../components/FactsStrip.astro';
import AwardLine from '../../components/AwardLine.astro';
import Figure from '../../components/Figure.astro';
import BookingWidget from '../../components/BookingWidget.astro';
import BookingTerms from '../../components/BookingTerms.astro';
import DistanceTable from '../../components/DistanceTable.astro';
import Reviews from '../../components/Reviews.astro';
import { localePaths, localeFromParam, liveCodes, lp, t, tf } from '../../lib/i18n';
import { page } from '../../lib/content';
import { fill, house } from '../../lib/villa';
import { vacationRentalLd } from '../../lib/jsonld';

export const getStaticPaths = localePaths;
const locale = localeFromParam(Astro.params.locale);
const c = page(locale, 'home').frontmatter;
const strip = ['03', '57', '18', '22', '11', '06'];
const near = ['Alassio beach and Budello', 'Laigueglia', 'Albenga', 'Genoa airport (GOA)', 'Nice airport (NCE)'];
const ld = await vacationRentalLd(locale, c.description);
const redirectable = JSON.stringify(liveCodes.filter((x) => x !== 'en'));
---
<Base locale={locale} slug="" title={fill(c.title)} description={fill(c.description)} overlayHeader>
  <Fragment slot="head">
    {locale === 'en' && <script is:inline set:html={`(function(){var l=new URLSearchParams(location.search).get('lang');var ok=${redirectable};if(l&&ok.indexOf(l.toLowerCase())>-1)location.replace('/'+l.toLowerCase()+'/');})();`} />}
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </Fragment>

  <!-- Essentials -->
  <Hero locale={locale} id="01" mobileId="04" title={c.hero.title} sub={c.hero.sub} meta={fill(t(locale, 'hero.sleeps'))} alt={t(locale, 'hero.alt')} position="50% 55%" whatsapp video />

  <div class="wrap facts-wrap"><FactsStrip locale={locale} /></div>

  <section class="section strip" aria-labelledby="strip-h">
    <div class="wrap">
      <div class="strip-head reveal">
        <div><span class="kicker">{c.strip.kicker}</span><h2 id="strip-h">{c.strip.title}</h2></div>
        <a class="link-arrow" href={lp(locale, 'gallery')}>{t(locale, 'common.seeGallery')}</a>
      </div>
      <ul class="strip-grid">
        {strip.map((id) => <li><a href={lp(locale, 'gallery')}><Figure id={id} locale={locale} ratio="1 / 1" sizes="(min-width: 60rem) 16vw, 50vw" widths={[320, 640]} /></a></li>)}
      </ul>
    </div>
  </section>

  <section class="section band points" aria-labelledby="points-h">
    <div class="wrap">
      <div class="reveal head">
        <span class="kicker">{c.points.kicker}</span>
        <h2 id="points-h">{c.points.title}</h2>
      </div>
      <ol class="point-list">
        {c.points.items.map((p: any) => (
          <li class="point reveal">
            <Figure id={p.photo} locale={locale} ratio="4 / 3" sizes="(min-width: 60rem) 30vw, 100vw" widths={[480, 800]} />
            <h3>{p.title}</h3>
            <p>{fill(p.text)}</p>
          </li>
        ))}
      </ol>
      <a class="link-arrow" href={lp(locale, 'villa')}>{t(locale, 'common.discoverVilla')}</a>
    </div>
  </section>

  <section class="section teaser" aria-labelledby="alassio-h">
    <div class="wrap split top">
      <div class="reveal">
        <span class="kicker">{c.alassio.kicker}</span>
        <h2 id="alassio-h">{c.alassio.title}</h2>
        <p>{c.alassio.text}</p>
        <Figure id="51" locale={locale} ratio="3 / 2" class="teaser-photo" />
      </div>
      <div class="reveal">
        <DistanceTable locale={locale} only={near} />
        <a class="link-arrow" href={lp(locale, 'alassio')}>{t(locale, 'common.discoverAlassio')}</a>
      </div>
    </div>
  </section>

  <!-- Trust -->
  <Reviews locale={locale} limit />

  <section class="section trust" aria-labelledby="intro-h">
    <div class="wrap split top">
      <div class="reveal">
        <span class="kicker">{c.intro.kicker}</span>
        <h2 id="intro-h">{c.intro.title}</h2>
        <p class="lead">{fill(c.intro.text)}</p>
        <AwardLine locale={locale} />
      </div>
      <div class="hosts reveal">
        <Figure id="59" locale={locale} ratio="4 / 5" sizes="10rem" widths={[320, 480]} class="hosts-photo" />
        <div>
          <span class="kicker">{c.hosts.kicker}</span>
          <h3>{c.hosts.title}</h3>
          <p>{c.hosts.text}</p>
          <a class="link-arrow" href={`${lp(locale, 'villa')}#hosts-h`}>{c.hosts.link}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Book -->
  <section class="booking-band" aria-labelledby="book-h">
    <div class="bb-photo">
      <Figure id="04" locale={locale} sizes="40vw" widths={[480, 900]} position="50% 70%" class="bb-wide" />
      <Figure id="05" locale={locale} sizes="100vw" widths={[480, 900]} position="50% 55%" class="bb-small" />
    </div>
    <div class="bb-body">
      <span class="kicker">{c.booking.kicker}</span>
      <h2 id="book-h">{c.booking.title}</h2>
      <p class="lead">{fill(c.booking.price)}</p>
      <BookingTerms locale={locale} />
      <BookingWidget locale={locale} />
      <h3 class="inc-h">{c.booking.includedTitle}</h3>
      <ul class="inc">{house.included.map((i: string) => <li>{tf(locale, i)}</li>)}</ul>
      <a class="link-arrow" href={lp(locale, 'book')}>{c.booking.more}</a>
    </div>
  </section>
</Base>

<style>
  .facts-wrap { margin-top: var(--space-4); }
  .head { margin-bottom: var(--space-4); }
  .strip-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: var(--space-2); margin-bottom: var(--space-3); }
  .strip-head h2 { margin: 0; }
  .strip-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: .5rem; }
  @media (min-width: 48rem) { .strip-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 72rem) { .strip-grid { grid-template-columns: repeat(6, 1fr); } }
  .strip-grid a { display: block; }
  .point-list { list-style: none; margin: 0 0 var(--space-4); padding: 0; display: grid; gap: var(--space-5); }
  @media (min-width: 60rem) { .point-list { grid-template-columns: repeat(3, 1fr); gap: var(--space-4); } }
  .point h3 { font-size: var(--step-2); margin-top: var(--space-3); }
  .point p { color: var(--c-ink-soft); max-width: 30rem; }
  .teaser :global(.teaser-photo) { margin-top: var(--space-3); }
  .teaser .link-arrow { margin-top: var(--space-3); }
  .trust .lead { margin-bottom: var(--space-4); }
  .hosts { display: grid; grid-template-columns: 8rem 1fr; gap: var(--space-3); align-items: start; }
  @media (min-width: 60rem) { .hosts { grid-template-columns: 10rem 1fr; padding-top: 4.2rem; } }
  .hosts h3 { font-size: var(--step-2); }
  .hosts p { color: var(--c-ink-soft); }
  .booking-band { display: grid; background: var(--c-surface); }
  .bb-photo :global(img) { width: 100%; height: 60svh; object-fit: cover; }
  /* Phones already see photo 04 in the hero, so the booking band uses another portrait photo there. */
  .bb-photo :global(.bb-wide) { display: none; }
  @media (min-width: 60rem) { .bb-photo :global(.bb-wide) { display: block; } .bb-photo :global(.bb-small) { display: none; } }
  .bb-body { padding: var(--space-5) var(--gutter); max-width: 44rem; }
  @media (min-width: 60rem) {
    .booking-band { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
    .bb-photo :global(figure), .bb-photo :global(picture) { height: 100%; }
    .bb-photo :global(img) { height: 100%; min-height: 40rem; }
    .bb-body { padding: var(--space-6) var(--space-5); }
  }
  .bb-body { border-top: 4px solid var(--c-dusk); }
  @media (min-width: 60rem) { .bb-body { border-top: 0; border-left: 4px solid var(--c-dusk); } }
  .inc-h { margin-top: var(--space-4); font-size: var(--step-0); font-family: var(--font-text); font-weight: 500; }
  .inc { columns: 2 14rem; column-gap: var(--space-4); padding-left: 1.1rem; margin: 0 0 var(--space-3); color: var(--c-ink-soft); }
  .inc li { margin-bottom: .3rem; break-inside: avoid; }
</style>
