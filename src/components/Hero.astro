---
import { getImage } from 'astro:assets';
import { alt as altFor, photo, type Photo } from '../lib/photos';
import { lp, t } from '../lib/i18n';
import { whatsappUrl } from '../lib/villa';
// textTop: headline over the top of the photo (e.g. trees); the photo is anchored to the top and
// zoomed slightly so its subject (house, pool) sits in the lower part, clear of the text.
// mobileId: a different (portrait) photo for phones and small tablets, below 60rem.
// alt: one description for both photos when mobileId is set (a single <img> serves both).
// whatsapp: show the 'Ask a question' WhatsApp button next to 'Check dates'.
// video: muted looping film over the photo, on screens from 60rem only. Nothing is downloaded on phones,
// with reduced motion or Save-Data; the photo stays underneath until the film plays, then fades out.
interface Props { locale: string; id: string; mobileId?: string; title: string; sub?: string; note?: string; alt?: string; position?: string; textTop?: boolean; whatsapp?: boolean; video?: boolean }
const { locale, id, mobileId, title, sub, note, alt, position = '50% 60%', textTop = false, whatsapp = false, video = false } = Astro.props;
const p = photo(id);
const m = mobileId ? photo(mobileId) : undefined;
const SMALL = '(max-width: 59.99rem)';

async function srcset(ph: Photo, widths: number[], format: 'avif' | 'webp') {
  const ws = widths.filter((w) => w <= ph.src.width);
  const imgs = await Promise.all(ws.map((w) => getImage({ src: ph.src, width: w, format, quality: 72 })));
  return imgs.map((img, i) => `${img.src} ${ws[i]}w`).join(', ');
}
const formats = ['avif', 'webp'] as const;
const mobileSources = m ? await Promise.all(formats.map(async (f) => ({ type: `image/${f}`, srcset: await srcset(m, [480, 720, 960, 1280], f) }))) : [];
const mainSources = await Promise.all(formats.map(async (f) => ({ type: `image/${f}`, srcset: await srcset(p, [640, 960, 1280, 1600, 2048], f) })));
const fw = Math.min(2048, p.src.width);
const fallback = await getImage({ src: p.src, width: fw, format: 'webp', quality: 72 });
---
<section class:list={['hero', { 'text-top': textTop, 'has-mobile': !!m }]}>
  <picture>
    {mobileSources.map((s) => <source media={SMALL} type={s.type} srcset={s.srcset} sizes="100vw" />)}
    {mainSources.map((s) => <source type={s.type} srcset={s.srcset} sizes="100vw" />)}
    <img src={fallback.src} alt={alt ?? altFor(locale, p)} width={fw} height={Math.round(fw * p.src.height / p.src.width)}
      loading="eager" fetchpriority="high" decoding="sync" class="hero-img" style={`--pos:${position}`} />
  </picture>
  {video && (
    <video class="hero-video" muted loop playsinline preload="none" aria-hidden="true" tabindex="-1"
      data-src-lg="/video/villa-dolce-azzurra-1920.mp4" data-src-sm="/video/villa-dolce-azzurra-1280.mp4"></video>
  )}
  {video && <button type="button" class="hero-pause" hidden aria-pressed="false" data-pause={t(locale, 'hero.pauseVideo')} data-play={t(locale, 'hero.playVideo')} aria-label={t(locale, 'hero.pauseVideo')}><span aria-hidden="true"></span></button>}
  <div class="hero-text wrap">
    {note && <p class="note">{note}</p>}
    <h1>{title}</h1>
    {sub && <p class="sub">{sub}</p>}
    <div class="ctas">
      <a class="btn btn-light" href={lp(locale, 'book')} data-cta="book">{t(locale, 'cta.checkDates')}</a>
      {whatsapp && whatsappUrl(locale) && <a class="btn btn-outline-light" href={whatsappUrl(locale)} rel="noopener">{t(locale, 'cta.whatsapp')}</a>}
    </div>
  </div>
</section>
{video && (
  <script>
    const v = document.querySelector<HTMLVideoElement>('.hero-video');
    const b = document.querySelector<HTMLButtonElement>('.hero-pause');
    const ok = matchMedia('(min-width: 60rem)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches
      && !(navigator as any).connection?.saveData;
    if (v && b && ok) {
      v.src = (innerWidth * devicePixelRatio > 1600 ? v.dataset.srcLg : v.dataset.srcSm)!;
      v.addEventListener('playing', () => { v.classList.add('on'); b.hidden = false; }, { once: true });
      v.play().catch(() => {});
      b.addEventListener('click', () => {
        const pause = !v.paused;
        if (pause) v.pause(); else v.play().catch(() => {});
        b.setAttribute('aria-pressed', String(pause));
        b.setAttribute('aria-label', (pause ? b.dataset.play : b.dataset.pause)!);
      });
    }
  </script>
)}
<style>
  .hero { position: relative; min-height: 88svh; display: flex; align-items: flex-end; color: #fff; overflow: hidden; isolation: isolate; }
  .hero :global(picture) { position: absolute; inset: 0; z-index: -2; }
  .hero :global(.hero-img) { width: 100%; height: 100%; object-fit: cover; object-position: var(--pos, 50% 60%); }
  .hero-video { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 1.2s var(--ease); }
  .hero-video.on { opacity: 1; }
  .hero-pause { position: absolute; right: var(--space-3); bottom: var(--space-3); z-index: 1; width: 44px; height: 44px; border-radius: 50%; border: 1px solid rgba(255, 255, 255, .7); background: rgba(18, 20, 16, .35); color: #fff; cursor: pointer; display: grid; place-items: center; }
  .hero-pause span { width: 12px; height: 14px; border-inline: 4px solid currentColor; box-sizing: border-box; }
  .hero-pause[aria-pressed="true"] span { border: 0; width: 0; height: 0; border-block: 8px solid transparent; border-left: 13px solid currentColor; margin-left: 4px; }
  .hero-pause:hover { background: rgba(18, 20, 16, .6); }
  .hero-pause[hidden] { display: none; }
  .hero::after { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(to top, rgba(18, 20, 16, .78) 0%, rgba(18, 20, 16, .5) 38%, rgba(18, 20, 16, .12) 72%, rgba(18, 20, 16, 0) 100%); }
  @media (min-width: 60rem) { .hero::after { background: linear-gradient(to top, rgba(18, 20, 16, .7) 0%, rgba(18, 20, 16, .25) 45%, rgba(18, 20, 16, 0) 70%), linear-gradient(to right, rgba(18, 20, 16, .5) 0%, rgba(18, 20, 16, .2) 45%, rgba(18, 20, 16, 0) 65%); } }
  .hero-text { padding-bottom: clamp(5.5rem, 10vh, 6.5rem); padding-top: 8rem; }
  @media (min-width: 60rem) { .hero-text { padding-bottom: var(--space-6); } }
  .ctas { display: flex; flex-wrap: wrap; gap: .75rem; }
  .btn-outline-light { color: #fff; border-color: rgba(255, 255, 255, .85); background: rgba(18, 20, 16, .15); }
  .btn-outline-light:hover { color: var(--c-ink); background: #fff; }
  .note { font: 500 var(--step--1)/1.4 var(--font-text); letter-spacing: .08em; text-transform: uppercase; margin: 0 0 var(--space-2); text-shadow: 0 1px 12px rgba(0, 0, 0, .35); }
  h1 { max-width: 19ch; margin-bottom: var(--space-2); text-shadow: 0 2px 30px rgba(0, 0, 0, .35); }
  .sub { max-width: 34rem; font-size: var(--step-1); line-height: 1.45; margin-bottom: var(--space-4); text-shadow: 0 1px 12px rgba(0, 0, 0, .3); }
  @media (min-width: 60rem) { .hero { min-height: 92svh; } }
  .hero.text-top { align-items: flex-start; }
  .hero.text-top :global(picture) { bottom: auto; height: 140%; }
  .hero.text-top::after { background: linear-gradient(to bottom, rgba(18, 20, 16, .62) 0%, rgba(18, 20, 16, .35) 38%, rgba(18, 20, 16, 0) 60%); }
  .hero.text-top .hero-text { padding-top: calc(var(--header-h) + var(--space-4)); padding-bottom: var(--space-4); }
  .hero.text-top h1 { margin-bottom: var(--space-1); }
  .hero.text-top .sub { margin-bottom: var(--space-3); }
  /* Phone photo: shown whole (portrait fits the screen), no extra zoom; text back at the bottom
     over the darker foreground, so the sky and the bay stay clear. */
  @media (max-width: 59.99rem) {
    .hero.has-mobile { align-items: flex-end; }
    .hero.has-mobile :global(picture) { height: 100%; }
    .hero.has-mobile :global(.hero-img) { object-position: 50% 50%; }
    .hero.has-mobile::after { background: linear-gradient(to top, rgba(18, 20, 16, .78) 0%, rgba(18, 20, 16, .5) 38%, rgba(18, 20, 16, 0) 65%); }
    .hero.has-mobile .hero-text { padding-top: 8rem; padding-bottom: clamp(5.5rem, 10vh, 6.5rem); }
  }
</style>
