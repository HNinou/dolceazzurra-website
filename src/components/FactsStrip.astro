---
import { t } from '../lib/i18n';
import { house, location } from '../lib/villa';
interface Props { locale: string }
const { locale } = Astro.props;
const c = house.capacity;
// [value, label, value after label]
const items: [string | number, string, boolean?][] = [
  [c.guests, t(locale, 'facts.guests')],
  [c.suites, t(locale, 'facts.suites')],
  [c.bathrooms, t(locale, 'facts.bathrooms')],
  ['', t(locale, 'facts.singleLevel')],
  ['', t(locale, 'facts.pool')],
  [location.distances[0].time.replace(/\bmin\b/, t(locale, 'common.min')), t(locale, 'facts.beach'), true],
];
---
<ul class="facts" aria-label={t(locale, 'facts.label')}>
  {items.map(([n, label, after]) => <li>{n !== '' && !after && <span class="n">{n}</span>}<span class="l">{label}</span>{after && <span class="n sm">{n}</span>}</li>)}
</ul>
<style>
  .facts { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); }
  .facts li { display: flex; align-items: center; justify-content: center; gap: .4rem; padding: 1.05rem .5rem; text-align: center; border-top: 1px solid var(--c-oak); }
  .facts li:nth-child(odd) { border-right: 1px solid var(--c-oak); }
  .facts li:nth-last-child(-n+2) { border-bottom: 1px solid var(--c-oak); }
  .n { font: 380 var(--step-2)/1 var(--font-display); }
  .n.sm { font-size: var(--step-1); }
  .l { font-size: var(--step--1); letter-spacing: .06em; text-transform: uppercase; color: var(--c-ink-soft); }
  @media (min-width: 48rem) {
    .facts { grid-template-columns: repeat(3, 1fr); }
    .facts li:nth-child(odd) { border-right: 0; }
    .facts li:not(:nth-child(3n)) { border-right: 1px solid var(--c-oak); }
    .facts li:nth-last-child(-n+3) { border-bottom: 1px solid var(--c-oak); }
  }
  @media (min-width: 72rem) {
    .facts { grid-template-columns: repeat(6, 1fr); border-block: 1px solid var(--c-oak); }
    .facts li, .facts li:nth-last-child(-n+3) { border: 0; padding-block: 1.6rem; }
    .facts li + li { border-left: 1px solid var(--c-oak) !important; }
  }
</style>
