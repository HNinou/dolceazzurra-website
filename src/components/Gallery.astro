---
import { Picture } from 'astro:assets';
import { getImage } from 'astro:assets';
import { alt as altFor, groups, photos } from '../lib/photos';
import { t } from '../lib/i18n';
import Lightbox from './Lightbox.astro';
interface Props { locale: string }
const { locale } = Astro.props;
const shown = photos.filter((p) => ['gallery', 'feature', 'hero'].includes(p.role));
const sections = await Promise.all(groups.map(async (g) => ({
  g,
  items: await Promise.all(shown.filter((p) => p.group === g).map(async (p) => ({
    // Viewer image: longest side at most 2048 px.
    p, full: (await getImage({ src: p.src, width: Math.round(Math.min(p.src.width, 2048 * p.src.width / Math.max(p.src.width, p.src.height))), format: 'webp', quality: 72 })).src,
  }))),
})));
// Photos marked display: small sit two to a tile, at half width.
const cellsOf = <T extends { p: { small?: boolean } }>(items: T[]) => {
  const out: T[][] = [];
  for (const it of items) {
    const last = out[out.length - 1];
    if (it.p.small && last && last.length === 1 && last[0].p.small) last.push(it);
    else out.push([it]);
  }
  return out;
};
// Portrait tiles first, so the grid packs into full rows.
const tallFirst = <T extends { p: { src: { width: number; height: number } } }>(cells: T[][]) =>
  [...cells.filter((c) => tall(c)), ...cells.filter((c) => !tall(c))];
let index = 0;
// Desktop column count per group, chosen so rows fill without orphan tiles
// (a portrait tile spans two rows; a pair of small photos takes one tile).
const tall = (cell: { p: { src: { width: number; height: number } } }[]) => cell.length === 1 && cell[0].p.src.height > cell[0].p.src.width;
const colsFor = (cells: { p: { src: { width: number; height: number } } }[][]) => {
  const n = cells.reduce((sum, c) => sum + (tall(c) ? 2 : 1), 0);
  return [3, 4, 2].find((c) => n % c === 0 && n >= c) ?? 3;
};
---
<div class="gallery" data-gallery>
  {sections.filter((s) => s.items.length).map((s) => ({ ...s, cells: tallFirst(cellsOf(s.items)) })).map((s) => (
    <section class="group" aria-labelledby={`g-${s.g}`}>
      <h2 id={`g-${s.g}`} class="gh"><span class="kicker">{t(locale, `gallery.groups.${s.g}`)}</span></h2>
      <ul class="grid" style={`--cols:${colsFor(s.cells)}`}>
        {s.cells.map((cell) => (
          <li class:list={{ pair: cell.length > 1, tall: tall(cell) }}>
            {cell.map(({ p, full }) => {
              const a = altFor(locale, p);
              const w = Math.min(cell.length > 1 ? 700 : 1400, p.src.width);
              return (
                <button type="button" class="tile" data-index={index++} data-full={full} data-alt={a} data-w={p.src.width} data-h={p.src.height}>
                  <Picture src={p.src} alt={a} formats={['avif', 'webp']} fallbackFormat="webp" quality={72} widths={[400, 700, 1000, 1400].filter((x) => x <= w)} width={w} height={Math.round(w * p.src.height / p.src.width)} sizes={cell.length > 1 ? '(min-width: 60rem) 16vw, (min-width: 36rem) 25vw, 50vw' : '(min-width: 60rem) 33vw, (min-width: 36rem) 50vw, 100vw'} loading="lazy" />
                  <span class="sr-only">{t(locale, 'gallery.enlarge')}</span>
                </button>
              );
            })}
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>
<Lightbox locale={locale} />
<style>
  .group + .group { margin-top: var(--space-5); }
  .gh { margin: 0 0 var(--space-3); }
  .gh .kicker { margin: 0; }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; gap: .6rem; grid-template-columns: 1fr; grid-auto-flow: dense; }
  @media (min-width: 36rem) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 60rem) { .grid { grid-template-columns: repeat(var(--cols, 3), 1fr); gap: .9rem; } }
  .grid li { aspect-ratio: 3 / 2; }
  @media (min-width: 36rem) { .grid li.tall { grid-row: span 2; aspect-ratio: auto; } }
  .grid li.pair { display: grid; grid-template-columns: 1fr 1fr; gap: .6rem; }
  @media (min-width: 60rem) { .grid li.pair { gap: .9rem; } }
  .tile { display: block; width: 100%; height: 100%; padding: 0; border: 0; background: var(--c-surface); cursor: zoom-in; overflow: hidden; }
  .tile :global(picture), .tile :global(img) { width: 100%; height: 100%; }
  .tile :global(img) { object-fit: cover; transition: transform .8s var(--ease); }
  .tile:hover :global(img) { transform: scale(1.025); }
</style>
