---
// Real guest reviews from villa.yaml -> house.reviews (quoted in the page language, marked when translated).
import { t } from '../lib/i18n';
import { booking, house, known } from '../lib/villa';
interface Props { locale: string; id?: string; band?: boolean; limit?: boolean }
// limit: two quotes on every screen size (phones always show two), the rest behind "More reviews".
const { locale, id = 'reviews', band = true, limit = false } = Astro.props;
const r = house.reviews;
const quotes = known(r.quotes) ? (r.quotes as any[]) : [];
const rating = known(r.airbnb?.rating) ? Number(r.airbnb.rating).toFixed(1).replace('.', t(locale, 'common.decimal')) : null;
const countryOf = (code?: string) => (code ? new Intl.DisplayNames([locale], { type: 'region' }).of(code) : undefined);
const monthOf = (m: string) => new Intl.DateTimeFormat(locale, { month: 'long', year: 'numeric' }).format(new Date(`${m}-15`));
---
{quotes.length > 0 && (
  <section class:list={['section', 'reviews', { band }]} aria-labelledby={`${id}-h`}>
    <div class="wrap">
      <div class="head reveal">
        <span class="kicker">{t(locale, 'reviews.kicker')}</span>
        <h2 id={`${id}-h`}>{t(locale, 'reviews.title')}</h2>
        {rating && <p class="rating"><a href={booking.airbnb_url} rel="noopener">{t(locale, 'reviews.rating').replace('{rating}', rating).replace('{count}', r.airbnb.count)}</a>{known(r.airbnb.label) && <> · {t(locale, 'reviews.favourite')}</>}</p>}
      </div>
      <ul class:list={['quotes', { limit }]} data-quotes>
        {quotes.map((q, n) => {
          const own = q.lang === locale;
          const text = own ? q.text : q[locale];
          return (
            <li class:list={['reveal', { extra: n >= 2 }]}>
              <blockquote lang={own ? q.lang : locale}>
                <p>{t(locale, 'reviews.open')}{text}{t(locale, 'reviews.close')}</p>
                <footer>
                  <span class="who">{q.name}</span>{q.place && <>, {q.place}</>}{q.country && <>, {countryOf(q.country)}</>} · {monthOf(String(q.month))} · {t(locale, 'reviews.source')}
                  {!own && <span class="tr">{t(locale, `reviews.translatedFrom.${q.lang}`)}</span>}
                </footer>
              </blockquote>
            </li>
          );
        })}
      </ul>
      {quotes.length > 2 && <button type="button" class:list={['btn', 'btn-ghost', 'more', { limit }]} data-more-reviews>{t(locale, 'reviews.more')}</button>}
    </div>
  </section>
)}
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-more-reviews]').forEach((btn) => {
    btn.addEventListener('click', () => {
      btn.previousElementSibling?.classList.add('all');
      btn.remove();
    });
  });
</script>
<style>
  .head { max-width: 44rem; margin-bottom: var(--space-4); }
  .rating { color: var(--c-ink-soft); margin: 0; }
  .quotes { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-4) var(--space-5); }
  @media (min-width: 48rem) { .quotes { grid-template-columns: 1fr 1fr; } }
  blockquote { margin: 0; padding-top: var(--space-3); border-top: 1px solid var(--c-oak); }
  blockquote p { font: 350 var(--step-1)/1.45 var(--font-display); margin-bottom: var(--space-2); }
  footer { font-size: var(--step--1); color: var(--c-ink-soft); }
  .who { color: var(--c-ink); font-weight: 500; }
  /* Phones: two quotes, the rest behind "More reviews". */
  .more { margin-top: var(--space-4); }
  @media (max-width: 47.99rem) { .quotes:not(.all) .extra { display: none; } }
  @media (min-width: 48rem) { .more:not(.limit) { display: none; } }
  .quotes.limit:not(.all) .extra { display: none; }
  .tr { display: block; margin-top: .2rem; font-style: italic; }
</style>
